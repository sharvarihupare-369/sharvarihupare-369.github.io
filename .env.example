# EmailJS Configuration
# 1. Sign up / log in at https://www.emailjs.com/
# 2. Email Services -> Add New Service (e.g. Gmail) -> Copy "Service ID"
# 3. Email Templates -> Create New Template -> Copy "Template ID"
#    Template fields: {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Account -> Security & API Keys -> Copy "Public Key"

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
